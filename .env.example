# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fingard_db
DB_USER=fingard
DB_PASSWORD=your_db_password_here

# ─── pgAdmin (Docker UI) ──────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@fingard.local
PGADMIN_PASSWORD=your_pgadmin_password_here

# ─── OpenAI (LangChain Agent) ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Slack Alerting ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL=#fin-guard-alerts

# ─── Power BI REST API ────────────────────────────────────────────────────────
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# ─── Agent Monitoring ─────────────────────────────────────────────────────────
# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# KPI Thresholds
PAR30_THRESHOLD=0.05          # 5%
DEFAULT_RATE_THRESHOLD=0.03   # 3%
ANOMALY_COUNT_THRESHOLD=50
NPL_RATIO_THRESHOLD=0.08      # 8%
